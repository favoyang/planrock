{
  "name": "@favoyang/planrock",
  "version": "1.4.0",
  "description": "Saved Markdown plan tracking for coding agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/favoyang/planrock.git"
  },
  "homepage": "https://github.com/favoyang/planrock#readme",
  "bugs": {
    "url": "https://github.com/favoyang/planrock/issues"
  },
  "keywords": [
    "agents",
    "cli",
    "codex",
    "plans",
    "skills"
  ],
  "bin": {
    "planrock": "scripts/planrock"
  },
  "files": [
    "SKILL.md",
    "skills/",
    "agents/",
    "scripts/planrock",
    "lib/",
    "dist/dashboard/",
    "README.md",
    "LICENSE",
    "LICENSES/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:dashboard": "vite build --config dashboard/vite.config.js",
    "prepack": "npm run build:dashboard",
    "test": "node --test tests/*.test.js",
    "test:dashboard": "vitest run --config dashboard/vite.config.js",
    "validate:package": "node scripts/validate-package.js"
  },
  "devDependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "26.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "vitest": "3.2.7"
  }
}
