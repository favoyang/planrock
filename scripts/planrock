#!/usr/bin/env node

const path = require("node:path");
const packageJson = require("../package.json");
const { DEFAULT_PORT } = require("../lib/constants");
const { dashboardStatus, mintUrl, readOwner, serveDashboard, startDashboard, stopDashboard } = require("../lib/dashboard");
const { loadIndex, loadLatestScan, pageCollection, refreshIndex } = require("../lib/indexer");
const { escapeTerminalControls, runGoal, runLocal } = require("../lib/local");
const { addProject, loadRegistry, registryDiagnostics, relinkProject, removeProject } = require("../lib/registry");
const { importTaskChef } = require("../lib/taskchef");
const { withStorageLock } = require("../lib/security");

function parse(argv) {
  const positional = []; const options = { json: false, fullAgentSession: false, workingDir: null, sort: "priority", port: undefined, limit: undefined, cursor: undefined, name: undefined, discovery: true };
  for (let index = 0; index < argv.length; index += 1) {
    const arg = argv[index];
    if (arg === "--json") options.json = true;
    else if (arg === "--full-agent-session") options.fullAgentSession = true;
    else if (["--working-dir", "--workspace", "--sort", "--port", "--limit", "--cursor", "--name"].includes(arg)) { if (!argv[index + 1]) throw new Error(`${arg} requires a value`); options[arg.slice(2).replace(/-([a-z])/g, (_, letter) => letter.toUpperCase())] = argv[++index]; }
    else if (/^--(working-dir|workspace|sort|port|limit|cursor|name)=/.test(arg)) { const [key, ...rest] = arg.slice(2).split("="); options[key.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase())] = rest.join("="); }
    else if (arg === "--no-discovery") options.discovery = false;
    else if (arg === "--help" || arg === "-h") options.help = true;
    else if (arg === "--version") options.version = true;
    else if (arg.startsWith("--")) throw new Error(`Unknown argument: ${arg}`);
    else positional.push(arg);
  }
  if (options.workspace && !options.workingDir) options.workingDir = options.workspace;
  if (!["priority", "time"].includes(options.sort)) throw new Error(`Unknown sort: ${options.sort}`);
  if (options.port !== undefined && (!/^\d+$/.test(String(options.port)) || Number(options.port) < 1 || Number(options.port) > 65535)) throw new Error("--port must be an integer from 1 to 65535");
  options.port = options.port === undefined ? undefined : Number(options.port);
  return { positional, options };
}

function workingDir(option) { return path.resolve(option || process.env.PLANROCK_WORKING_DIR || process.env.PLANROCK_WORKSPACE || process.cwd()); }
function escapeTerminalValue(value) { if (typeof value === "string") return escapeTerminalControls(value); if (Array.isArray(value)) return value.map(escapeTerminalValue); if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [escapeTerminalControls(key), escapeTerminalValue(item)])); return value; }
function output(value, json) { if (json) console.log(JSON.stringify(value, null, 2)); else { const safe = escapeTerminalValue(value); console.log(typeof safe === "string" ? safe : JSON.stringify(safe, null, 2)); } }
function printOverview(snapshot, limit = 50) {
  console.log("Planrock Overview"); console.log(`Refreshed: ${snapshot.refreshedAt}`); console.log(`Projects: ${snapshot.summary.projects}  Open: ${snapshot.summary.open}  Closed: ${snapshot.summary.closed}  Invalid: ${snapshot.summary.invalid}`);
  if (snapshot.incomplete) console.log("Health: incomplete scan");
  for (const item of snapshot.diagnostics.filter((entry) => entry.severity !== "info").slice(0, 10)) console.log(`${item.severity.toUpperCase()} ${item.code}: ${escapeTerminalControls(item.message)}`);
  console.log(""); console.log("Next up"); console.log("Priority  Project  Title  Done/Total  Created"); console.log("--------  -------  -----  ----------  -------");
  for (const plan of snapshot.openPlans.slice(0, limit)) console.log(`${escapeTerminalControls(plan.priority)}  ${escapeTerminalControls(plan.projectName)}  ${escapeTerminalControls(plan.title)}  ${plan.checklistDone}/${plan.checklistTotal}  ${escapeTerminalControls(plan.createdAt)}`);
  if (snapshot.openPlans.length > limit) console.log(`… ${snapshot.openPlans.length - limit} more (use --json with bounded pagination)`);
}
function help() { console.log(`Usage: planrock [status|pending|active|open|closed] [--working-dir <path>] [--sort priority|time] [--json] [--full-agent-session] [--version]
       planrock goal <path-to-plan>
       planrock overview [--json] [--limit <1-1000>] [--cursor <opaque> (JSON only)]
       planrock refresh [--json]
       planrock project add <path> --name <unique-name> [--no-discovery] [--json]
       planrock project remove|relink|list|validate|import ...
       planrock dashboard start|open|status|stop [--port <number>] [--json]

Existing repository-local commands retain their prior behavior. Global Planrock data is stored only in ~/.agents/planrock. Registry schema 2 uses one top-level ignore array; relative entries prune directories and canonical absolute entries exclude exact project roots.`); }

async function main() {
  let parsed; try { parsed = parse(process.argv.slice(2)); } catch (error) { console.error(escapeTerminalControls(error.message)); process.exitCode = 1; return; }
  const { positional, options } = parsed;
  if (options.help) { help(); return; } if (options.version) { console.log(packageJson.version); return; }
  const command = positional[0] || "status";
  try {
    if (["status", "pending", "active", "open", "closed"].includes(command)) { if (positional.length > 1) throw new Error(`Unknown argument: ${positional[1]}`); runLocal(command, { workingDir: workingDir(options.workingDir), sort: options.sort, json: options.json, fullAgentSession: options.fullAgentSession }); return; }
    if (command === "goal") { if (positional.length > 2) throw new Error(`Unknown argument: ${positional[2]}`); runGoal(positional[1], workingDir(options.workingDir)); return; }
    if (command === "overview") {
      if (options.cursor && !options.json) throw new Error("--cursor requires --json");
      const snapshot = options.cursor ? loadIndex({ refreshIfMissing: false }) : refreshIndex({ trigger: "overview" });
      if (!snapshot) throw new Error("No persisted Planrock snapshot exists for this cursor; run overview without --cursor first");
      const latestScan = loadLatestScan({ snapshotId: snapshot.snapshotId });
      if (options.json && (options.cursor || options.limit)) output({ overview: { schemaVersion: 2, snapshotId: snapshot.snapshotId, refreshedAt: snapshot.refreshedAt, incomplete: snapshot.incomplete, latestScan, summary: snapshot.summary, diagnostics: snapshot.diagnostics.slice(0, 100), omittedDiagnostics: Math.max(0, snapshot.diagnostics.length - 100) }, page: pageCollection(snapshot, "openPlans", { cursor: options.cursor, limit: options.limit }) }, true);
      else if (options.json) { const nextUp = pageCollection(snapshot, "openPlans", { limit: 50 }); output({ schemaVersion: 2, snapshotId: snapshot.snapshotId, refreshedAt: snapshot.refreshedAt, incomplete: snapshot.incomplete, latestScan, summary: snapshot.summary, diagnostics: snapshot.diagnostics.slice(0, 100), omittedDiagnostics: Math.max(0, snapshot.diagnostics.length - 100), nextUp: nextUp.items, omittedNextUp: Math.max(0, snapshot.openPlans.length - nextUp.items.length) }, true); }
      else printOverview(snapshot, Math.max(1, Math.min(Number(options.limit) || 50, 1000)));
      return;
    }
    if (command === "refresh") { const snapshot = refreshIndex({ trigger: "cli" }); output(options.json ? { schemaVersion: 2, snapshotId: snapshot.snapshotId, refreshedAt: snapshot.refreshedAt, incomplete: snapshot.incomplete, latestScan: loadLatestScan({ snapshotId: snapshot.snapshotId }), summary: snapshot.summary, diagnostics: snapshot.diagnostics.slice(0, 100), omittedDiagnostics: Math.max(0, snapshot.diagnostics.length - 100) } : `Refreshed ${snapshot.summary.projects} projects at ${snapshot.refreshedAt}${snapshot.incomplete ? " (incomplete)" : ""}`, options.json); return; }
    if (command === "project") {
      const action = positional[1];
      if (action === "add") { if (!options.name || !positional[2]) throw new Error("project add requires <path> and --name"); output(withStorageLock("data", () => addProject(loadRegistry({ migrate: false }), { name: options.name, root: positional[2], discovery: options.discovery })), options.json); return; }
      if (action === "remove") { output(withStorageLock("data", () => removeProject(loadRegistry({ migrate: false }), positional[2])), options.json); return; }
      if (action === "relink") { if (!positional[2] || !positional[3]) throw new Error("project relink requires <id-or-name> <new-path>"); output(withStorageLock("data", () => relinkProject(loadRegistry({ migrate: false }), positional[2], positional[3])), options.json); return; }
      if (action === "list") { const registry = loadRegistry(); const limit = Math.max(1, Math.min(Number(options.limit) || 100, 1000)); const projects = registry.projects.slice(0, limit); output(options.json ? { schemaVersion: 2, projects, ignore: registry.ignore, omitted: registry.projects.length - projects.length } : projects.map((item) => `${escapeTerminalControls(item.name)}\t${escapeTerminalControls(item.root)}\t${escapeTerminalControls(item.source)}`).join("\n") || "(none)", options.json); return; }
      if (action === "validate") { const diagnostics = registryDiagnostics(loadRegistry()); output(options.json ? { valid: !diagnostics.some((item) => item.severity === "error"), diagnostics } : diagnostics.length ? diagnostics.map((item) => `${escapeTerminalControls(item.severity.toUpperCase())} ${escapeTerminalControls(item.code)}: ${escapeTerminalControls(item.message)}`).join("\n") : "Registry is valid.", options.json); return; }
      if (action === "import" && positional[2] === "taskchef") { output(withStorageLock("data", () => importTaskChef(loadRegistry({ migrate: false }))), options.json); return; }
      throw new Error("Unknown project command");
    }
    if (command === "dashboard") {
      const action = positional[1] || "status";
      if (action === "serve") { await serveDashboard(options.port || DEFAULT_PORT); return; }
      if (action === "start") { output(await startDashboard(options.port || DEFAULT_PORT), options.json); return; }
      if (action === "status") { output(await dashboardStatus(options.port), options.json); return; }
      if (action === "open") { const owner = readOwner(); if (!owner) throw new Error("Planrock dashboard is not running"); if (options.port !== undefined && owner.port !== options.port) throw new Error(`Recorded dashboard uses port ${owner.port}; --port ${options.port} assertion failed`); output({ url: await mintUrl(owner), port: owner.port }, options.json); return; }
      if (action === "stop") { output(await stopDashboard(options.port), options.json); return; }
      throw new Error("Unknown dashboard command");
    }
    throw new Error(`Unknown argument: ${command}`);
  } catch (error) { console.error(escapeTerminalControls(error.message)); process.exitCode = 1; }
}

main();
